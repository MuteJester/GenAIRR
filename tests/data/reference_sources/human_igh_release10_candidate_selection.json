{
  "schema": "genairr_reference_source_selection_candidate",
  "schema_version": 1,
  "description": "Candidate allele selection for a human IGH observed-span reference built from OGRDB IGH_VDJ release 10. Every record of the 'airr' export is either selected or omitted with the rules it fails. Every selected allele uses its own 'airr' record; for alleles whose 'airr' and 'airr_ex' records differ, record_choices states the choice per allele. Selection order within each segment is natural label order (numeric runs compared as integers). Labels are the provider labels, unchanged.",
  "source": {
    "set_id": "9606.IGH_VDJ",
    "release": 10,
    "germline_set_ref": "OGRDB:IGH_VDJ.10",
    "record_export": "airr",
    "record_export_sha256": "6889fea1e2da71ff2bde50f8b5e055613319408977e913631c8e6d04f53d44b1",
    "comparison_export": "airr_ex",
    "comparison_export_sha256": "251c5f13705b74f3bdaf6fc6f593616f433c710a766d8e54f9cbc9c2f1ac95d3",
    "gapped_sha256": "681db69932757bd09253cbef990a64959f8c8745e46f364bcb35963ea4f16a65",
    "gapped_ex_sha256": "2321eb5b788bf95103a2221eb327ef327c735e3e9427713c71285dcc6df81d9a"
  },
  "identity_policy": "Alleles with identical DNA under distinct gene or allele identities are retained as separate identities. The default samples uniformly over allele identities, so their combined probability of contributing that sequence reflects distinct, legitimate identities rather than accidental duplicate records. Each identity is selected from its own 'airr' record and keeps only its own evidence (anchor fields, functional, curational_tags, gapped record, support entries); nothing is copied from an identical-sequence counterpart.",
  "rules": [
    {
      "rule": "explicit_record_choice",
      "requirement": "Where a label has records in both 'airr' and 'airr_ex' and they differ, the label is selectable only with a per-allele record choice recorded in record_choices, and only if the records differ in nothing but coding_sequence (and allele_description_ref, which always carries the '_ext' suffix in 'airr_ex'). Choices are recorded only for alleles that pass every other rule. A label with a record only in 'airr' needs no choice."
    },
    {
      "rule": "provider_functional_true",
      "requirement": "Provider field functional is true. A false value is not interpreted further (not mapped to pseudogene)."
    },
    {
      "rule": "not_tagged_likely_truncated",
      "requirement": "Provider curational_tags does not contain likely_truncated."
    },
    {
      "rule": "v_gapped_record_matches",
      "requirement": "V only, variant-specific: the chosen 'airr' record has a label-identical record in the 'gapped' export whose ungapped bytes equal its coding_sequence, and 1 + the non-gap count in gapped columns 1-312 equals its cdr3_start. Where the label also has an 'airr_ex' record, that record must match its label-identical 'gapped_ex' record exactly (kept as evidence). A label absent from 'airr_ex' is not required to appear in 'gapped_ex'."
    },
    {
      "rule": "v_imgt_104_is_cys",
      "requirement": "V only: the junction anchor codon coding_sequence[cdr3_start-4 : cdr3_start-1] (IMGT codon 104 in the source alignment) is TGT or TGC. This rule exists so that canonical_productive stays available for the starter: the reference API has no user view narrowing, so one V whose anchor codon is not Cys would make that capability unavailable for the whole reference. It concerns the junction anchor codon only, not domain integrity: alleles with non-canonical residues at IMGT 23 or 41 (IGHV3-20*02, IGHV3-25*04) are kept because no declared capability depends on them. Non-Cys anchor codons stay in the inventory unrelocated."
    },
    {
      "rule": "j_landmark_consistent",
      "requirement": "J only: the codon at coding_sequence[j_cdr3_end-1 : j_cdr3_end+2] is TGG and (j_cdr3_end-1) - (j_codon_frame-1) is a multiple of 3."
    }
  ],
  "record_choice_reason": "Explicit observed-span policy: for these alleles the 'airr' record is chosen because its coding_sequence ends at gene_end, the same span definition used by every other selected V. The 'airr_ex' 3' extension is a provider candidate physical-end interpretation; it is not adopted and is kept as the recorded alternative. Because the unfitted defaults disable trimming, V 3' bases appear in junctions, which is why the choice changes simulated sequences; that explains its effect, it does not establish which end is biologically correct.",

  "scope": {
    "supported": "Source-backed BCR VDJ clonal_lineage; multi-clone; all rejected growth attempts and accepted extinction; neutral/explicit/automatic targets; supported per-cell read corruption; retained root/unsampled cellular replay.",
    "replay_guarantee": "Zero fresh RNG semantic choice replay under recorded support, control flow, exact native context, state/events and typed output. Not seed-stream provenance, authorship or empirical calibration.",
    "unfitted_defaults": "Equal eligible authored repair-history weights remain explicit unfitted controls; no new biochemical rates.",
    "unsupported": "Fixed/repertoire or legacy lineage bundles, arbitrary external snapshots, VJ, phased genotype families, revision, contaminants and paired-end adapters.",
    "resource_limits": "Conservative captured offspring bound lambda_base*(1+selection_strength)<=64. Configurable software-accounted execution/history/output ceilings are not a hard process-RSS limit.",
    "publication": "Prepublication failures preserve old destination. Atomic complete-file publication precedes directory fsync; a postpublication sync failure reports uncertain crash persistence and may leave the complete new file visible.",
    "performance": "Full-length JSON/evidence-heavy capture is opt-in and materially more costly than uncaptured generation. Descriptive isolated shared-host measurements, not production-throughput guarantees."
  },
  "development_findings": [
    "Oversized JSON integers initially promoted silently to binary64; lexical integer-range validation added, with regression tests.",
    "Existing InvertD panic-message test changed to verify its newly structured permissive missing-assignment error and unchanged zero-choice/zero-RNG failure.",
    "Review closed actual-policy replay, zero-weight/transformed support, extreme S5F normalization, missing work fences, nested legacy trace extras, final-node aggregate budget and exact attempt counting.",
    "Final resource closure scopes output materialization, merges, projection and validation; charges copied trace/event containers and preserves native Arc sharing. Two exact-history regressions and three native helper tests were added, then all 3138 Python tests and full native suites passed on the final binary.",
    "An initial pre-scoped full run also passed all 3133 then-collected nonperformance Python tests; the final suite includes the additional output-copy regressions.",
    "Several initial new-test failures were fixture/API/scope authoring mistakes; corrected before focused/full release verification."
  ],
